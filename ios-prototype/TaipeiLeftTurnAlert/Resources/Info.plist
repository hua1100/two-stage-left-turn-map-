<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App 基本資訊 -->
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_TW</string>
	<key>CFBundleDisplayName</key>
	<string>台北市左轉提示</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- 最低 iOS 版本 -->
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>

	<!-- 支援的裝置方向 -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- iPhone 專用設定 -->
	<key>UISupportedInterfaceOrientations~iphone</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- 位置權限說明 -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>需要持續存取您的位置，以便在接近可直接左轉路口時提供即時語音提示。即使 App 在背景運行或與導航 App 並用時，也能正確提醒您。</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>需要持續存取您的位置，以便在接近可直接左轉路口時提供即時語音提示。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>需要存取您的位置，以便在地圖上顯示您的當前位置，並在接近可直接左轉路口時提供語音提示。</string>

	<!-- 背景模式 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
	</array>

	<!-- 需要持續背景位置更新 -->
	<key>UIRequiresPersistentWiFi</key>
	<false/>

	<!-- 顯示背景位置指示器 (iOS 11+) -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>

	<!-- 語音合成設定 -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>用於語音提示功能</string>

	<!-- Launch Screen -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
		<key>UIImageName</key>
		<string></string>
	</dict>

	<!-- 狀態列樣式 -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- 支援的檔案類型 -->
	<key>UTExportedTypeDeclarations</key>
	<array/>
	<key>UTImportedTypeDeclarations</key>
	<array/>
</dict>
</plist>
